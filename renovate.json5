{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'security:minimumReleaseAgeNpm',
    ':dependencyDashboard',
  ],
  pinDigests: false,
  timezone: 'Asia/Tokyo',
  rangeStrategy: 'bump',
  prConcurrentLimit: 20,
  prHourlyLimit: 10,
  reviewers: [
    'Soli0222',
  ],
  assignees: [
    'Soli0222',
  ],
  semanticCommits: 'enabled',
  prCreation: 'immediate',
  rebaseWhen: 'auto',
  dependencyDashboard: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
  customManagers: [
    {
      description: 'Update ARG NODE_VERSION in the Dockerfile, which the dockerfile manager cannot update because FROM uses the variable',
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG NODE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      depNameTemplate: 'node',
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      description: 'Pinned exactly by the peerDependencies of @misskey-dev/oxlint-fmt-config. Update it manually together with fmt-config',
      matchPackageNames: ['@stylistic/eslint-plugin'],
      enabled: false,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      commitMessageTopic: 'GitHub Action {{depName}}',
      automerge: true,
    },
    {
      matchManagers: [
        'docker-compose',
        'dockerfile',
      ],
      matchDepNames: [
        '!node',
      ],
      commitMessageTopic: 'Docker {{depName}}',
      automerge: true,
    },
    {
      matchDepNames: [
        'node',
      ],
      groupName: 'node',
      commitMessageTopic: 'Node.js',
      automerge: true,
    },
    {
      matchManagers: [
        'npm',
      ],
      commitMessageTopic: 'Node {{depName}}',
      automerge: true,
    },
    {
      "description": "Track the latest stable Node.js release, including new majors before LTS.",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "versioning": "npm",
      "enabled": true,
      "ignoreUnstable": true,
      "separateMajorMinor": false,
      "automerge": true,
      "semanticCommitType": "fix"
    },
    {
      "description": "Do not delay runtime security updates; keep npm package cooldowns.",
      "matchPackageNames": [
        "node"
      ],
      "groupName": "Node.js",
      "prPriority": 10,
      "prConcurrentLimit": 0,
      "branchConcurrentLimit": 0,
      "prHourlyLimit": 0,
      "minimumReleaseAge": "0 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Separate the Docker variant from the stable Node.js version.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "versionCompatibility": "^(?<version>[^-]+)(?<compatibility>-.*)?$"
    },
  ],
}
