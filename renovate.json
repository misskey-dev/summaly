{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"schedule:weekly",
		":maintainLockFilesMonthly",
		"helpers:pinGitHubActionDigestsToSemver"
	],
	"timezone": "Asia/Tokyo",
	"minimumReleaseAge": "7 days",
	"osvVulnerabilityAlerts": true,
	"configMigration": true,
	"packageRules": [
		{
			"description": "パッチアップデートはまとめて1つのPRにする（0.x を含む）",
			"matchUpdateTypes": ["patch"],
			"groupName": "non-major dependencies"
		},
		{
			"description": "マイナーアップデートはまとめて1つのPRにする（0.x を除く）",
			"matchUpdateTypes": ["minor"],
			"matchCurrentVersion": "!/^v?0\\./",
			"groupName": "non-major dependencies"
		},
		{
			"description": "0.x のマイナーアップデートは破壊的変更とみなし、グループ化せずダッシュボードで承認したときだけPRを作る",
			"matchUpdateTypes": ["minor"],
			"matchCurrentVersion": "/^v?0\\./",
			"dependencyDashboardApproval": true
		},
		{
			"description": "メジャーアップデートはグループ化せず、ダッシュボードで承認したときだけPRを作る",
			"matchUpdateTypes": ["major"],
			"dependencyDashboardApproval": true
		},
		{
			"description": "同時に上げないと壊れる lint 関連のパッケージ（oxlint-fmt-config が oxlint / oxlint-tsgolint / @stylistic/eslint-plugin を peerDependencies に持つ）",
			"matchPackageNames": [
				"oxlint",
				"oxlint-tsgolint",
				"@misskey-dev/oxlint-fmt-config",
				"@stylistic/eslint-plugin"
			],
			"groupName": "oxlint toolchain"
		},
		{
			"description": "lockfile maintenance と digest 固定にはリリース日時がないので minimumReleaseAge を外す（間接依存の待機は pnpm-workspace.yaml の minimumReleaseAge で担保）",
			"matchUpdateTypes": ["lockFileMaintenance", "pin", "pinDigest"],
			"minimumReleaseAge": null
		}
	]
}
